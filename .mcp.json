{
  "mcpServers": {
    "agent-native-assets": {
      "type": "http",
      "url": "https://assets.agent-native.com/_agent-native/mcp"
    },
    "claude-flow": {
      "command": "npx",
      "args": [
        "ruflo@latest",
        "mcp",
        "start"
      ]
    },
    "scrapegraph-mcp": {
      "type": "http",
      "url": "https://sgai-mcp-main.onrender.com",
      "headers": {
        "X-API-Key": "${SGAI_API_KEY}"
      }
    }
  }
}
